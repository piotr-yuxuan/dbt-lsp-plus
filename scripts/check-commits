#!/usr/bin/env bash
# SPDX-License-Identifier: EUPL-1.2 OR GPL-3.0-or-later
#
# Usage: scripts/check-commits BASE
#
# Check every commit in BASE..HEAD: its title has at most 50 characters,
# starts with a capital letter and does not end with a full stop; its
# message has no attribution trailer; its message, author and committer
# hold none of the text that scripts/public-patterns.sh describes.  A version
# commit of the pipeline is accepted by its exact shape, with GitHub's own
# author and committer, whose address is not the noreply identity.  The
# size ratchet: once the first parent's Makefile has a ceiling, a commit,
# a merge included, that does not say why on a line of its body that
# reads "Raises the size ceilings: WHY" keeps each of SIZE_LINES and
# SIZE_TYPES one line `NAME := N`, N no higher than the parent's, with no
# other assignment of either, in any form, and leaves the rules of `size`
# and `check-static`, and each recipe line that runs check-size, as they
# were.  Print each finding as COMMIT: MESSAGE, and exit with status 1 when there
# is any, 2 when the check could not run.

set -uo pipefail
export LC_ALL=C.UTF-8

# shellcheck source=scripts/public-patterns.sh
source "$(dirname "$0")/public-patterns.sh"

if (( $# != 1 )); then
  echo "usage: scripts/check-commits BASE" >&2
  exit 2
fi

commits=$(git rev-list --reverse "$1..HEAD") || exit 2
words=$(public_words) || { echo "check-commits: cannot find the private words" >&2; exit 2; }
user=$(public_user)
status=0
# The address is split so that this file passes scripts/check-public.
version_people=$'github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nGitHub <noreply@''github.com>'
version_message=$'^Version (0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\n\n\\[skip ci]$'

# Note a finding $2 for the commit $1.
finding() {
  echo "$1: $2"
  status=1
}

# Print the lines of the Makefile at the commit $1 that the size ratchet
# rests on: each assignment of SIZE_LINES or SIZE_TYPES, in any form; the
# rules of `size` and `check-static`; each recipe line that runs check-size.
guarded() {
  git show "$1:Makefile" 2>/dev/null | grep -E \
    -e '^[[:space:]]*((override|export)[[:space:]]+)*SIZE_(LINES|TYPES)[[:space:]]*(:{1,3}|[!?+])?=' \
    -e '^(size|check-static)[[:space:]]*:' -e $'^\t.*check-size'
}

# Return whether the text $2 matches the Perl regexp $1, read as bytes.
matches() {
  LC_ALL=C grep -aqP -- "$1" <<<"$2"
}

for commit in $commits; do
  short=$(git rev-parse --short "$commit")
  title=$(git log -1 --format=%s "$commit")
  message=$(git log -1 --format=%B "$commit")
  people=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$commit")
  text="$message"$'\n'"$people"
  if [[ $people == "$version_people" && $message =~ $version_message ]]; then continue; fi
  (( ${#title} <= 50 )) || finding "$short" "title longer than 50 characters: $title"
  [[ $title =~ ^[[:upper:]] ]] || finding "$short" "title does not start with a capital letter: $title"
  [[ $title != *. ]] || finding "$short" "title ends with a full stop: $title"
  # Trailer keys are case-insensitive; "Generated with" only opens a line.
  if grep -qiE '^[[:space:]]*(co-authored-by|signed-off-by|assisted-by|generated-by):' <<<"$message" \
     || grep -qE '^[^[:alnum:]]*Generated with ' <<<"$message"; then
    finding "$short" "attribution in the message"
  fi
  ! matches "$public_dash" "$message" || finding "$short" "Unicode dash (U+2013 or U+2014)"
  ! matches "$public_path" "$message" || finding "$short" "private path"
  ! matches "$public_email" "$text" || finding "$short" "e-mail address"
  if [[ -n $user ]] && matches "$user" "$text"; then
    finding "$short" "machine user name"
  fi
  while IFS= read -r pattern; do
    if [[ -n $pattern ]] && matches "$pattern" "$text"; then
      finding "$short" "private word"
    fi
  done <<<"$words"
  first=$(git rev-parse -q --verify "$commit^1") || continue
  before=$(guarded "$first")
  after=$(guarded "$commit")
  if ! grep -qE '^SIZE_(LINES|TYPES) :=' <<<"$before" \
     || grep -qE '^Raises the size ceilings: *[^[:space:]]' <<<"$(git log -1 --format=%b "$commit")"; then
    continue
  fi
  unsaid=' without "Raises the size ceilings: WHY"'
  own='^SIZE_(LINES|TYPES) := [0-9]+$'
  if [[ $(grep -vE "$own" <<<"$before") != "$(grep -vE "$own" <<<"$after")" ]]; then
    finding "$short" "the size check's rules changed$unsaid"
  fi
  for name in SIZE_LINES SIZE_TYPES; do
    was=$(sed -n "s/^$name := \([0-9][0-9]*\)\$/\1/p" <<<"$before" | sort -n | tail -n 1)
    now=$(sed -n "s/^$name := \([0-9][0-9]*\)\$/\1/p" <<<"$after")
    if [[ ! $now =~ ^[0-9]+$ ]]; then
      finding "$short" "$name is not one line \"$name := N\"$unsaid"
    elif [[ -n $was ]] && (( 10#$now > 10#$was )); then
      finding "$short" "$name raised from $was to $now$unsaid"
    fi
  done
done

exit "$status"

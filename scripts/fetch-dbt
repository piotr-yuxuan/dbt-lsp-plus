#!/usr/bin/env python3
# SPDX-License-Identifier: EUPL-1.2 OR GPL-3.0-or-later
"""Fetch a build of dbt for CI, checked by its SHA-256, and keep its binary alone.

Usage: scripts/fetch-dbt [--latest] BUILD DIR

BUILD is `oss`, dbt-oss 2.0.11 from GitHub's release of dbt-labs/dbt, or `proprietary`, dbt
2.0.9 from dbt Labs' CDN, under dbt Labs' licence; the pins are those of the owner's Nix
packages.  With `--latest`, the latest stable build instead, as the weekly runs want it:
for `oss`, the highest release tag vX.Y.Z of GitHub's, compared as numbers, not a draft nor
a pre-release, that holds the Linux archive with GitHub's SHA-256 of it; for
`proprietary`, the stable tag of dbt Labs' versions.json, as dbt Labs' installer reads it,
checked by the SHA-256 that dbt Labs publishes beside the archive.  It prints `BUILD VERSION
URL SHA256` first.  The archive is downloaded into a scratch directory inside DIR, its hash checked
before anything is read from it, and only its one regular file named `dbt` is written, as
DIR/dbt, executable, whichever directory the archive keeps it in.  No path of the archive
is ever written.  It needs Python 3.11 or later, and runs with the runner's own.

Status 0, with DIR/dbt.  Status 2, with one line on standard error and no DIR/dbt: an
argument is wrong, the download failed, ran past its time or size, or the archive's hash
or contents are not what the pin says.
"""

import hashlib
import http.client
import json
import os
import re
import shutil
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

BUILDS = {
    "oss": (
        "https://github.com/dbt-labs/dbt/releases/download/v2.0.11/"
        "dbt-core-2.0.11-x86_64-unknown-linux-gnu.tar.gz",
        "bf468f6f43f6d64eb636c2dd9deb7d1eb17f7c57a09d509c0836b44c60688b4c",
    ),
    "proprietary": (
        "https://public.cdn.getdbt.com/fs/cli/fs-v2.0.9-x86_64-unknown-linux-gnu.tar.gz",
        "cc57e1f6a40d9d62008d2242c03fc8fbe5cca289c957abf784f9a6267bc4b0ef",
    ),
}
# Seconds that the download may wait for each read, and the bytes it may bring: both
# archives are about 56 and 107 MB.
TIMEOUT_SECONDS = 120
LIMIT_BYTES = 512 * 2**20
CHUNK_BYTES = 2**20
# Where the latest builds are found, and the bytes that a listing of them may bring.
RELEASES = "https://api.github.com/repos/dbt-labs/dbt/releases?per_page=100"
VERSIONS = "https://public.cdn.getdbt.com/fs/versions.json"
CDN = "https://public.cdn.getdbt.com/fs/cli"
GITHUB = "https://github.com/dbt-labs/dbt/releases/download"
LISTING_BYTES = 16 * 2**20
TAG = re.compile(r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")
DIGEST = re.compile(r"[0-9a-f]{64}")


class FetchError(Exception):
    """A download or an archive that cannot be trusted as the pin describes it."""


def latest_oss(releases: object) -> tuple[str, str, str]:
    """The version, archive URL and SHA-256 of the latest dbt-oss in GitHub's RELEASES."""
    found = []
    for release in [r for r in releases if isinstance(r, dict)] if isinstance(releases, list) else []:
        tag = TAG.fullmatch(str(release.get("tag_name", "")))
        if tag is None or release.get("draft") is not False or release.get("prerelease") is not False:
            continue
        version = tag.group(0).removeprefix("v")
        name = f"dbt-core-{version}-x86_64-unknown-linux-gnu.tar.gz"
        listed = release.get("assets") if isinstance(release.get("assets"), list) else []
        assets = [asset for asset in listed if isinstance(asset, dict) and asset.get("name") == name]
        digest = str(assets[0].get("digest") or "").removeprefix("sha256:") if len(assets) == 1 else ""
        if DIGEST.fullmatch(digest):
            found.append(
                (tuple(map(int, tag.groups())), version, f"{GITHUB}/v{version}/{name}", digest)
            )
    if not found:
        message = "no release vX.Y.Z of dbt-labs/dbt holds the Linux archive with its SHA-256"
        raise FetchError(message)
    _, version, url, digest = max(found)
    return version, url, digest


def latest_proprietary(versions: object) -> tuple[str, str]:
    """The version and archive URL of the stable proprietary dbt in dbt Labs' VERSIONS."""
    stable = versions.get("stable") if isinstance(versions, dict) else None
    tag = TAG.fullmatch(str(stable.get("tag", ""))) if isinstance(stable, dict) else None
    if tag is None:
        message = f"versions.json gives no stable tag vX.Y.Z: {stable!r}"
        raise FetchError(message)
    version = tag.group(0).removeprefix("v")
    return version, f"{CDN}/fs-v{version}-x86_64-unknown-linux-gnu.tar.gz"


def sidecar_digest(text: str, url: str) -> str:
    """The SHA-256 that TEXT, the `.sha256` beside the archive at URL, gives for that archive."""
    fields = text.split()
    if len(fields) != 2 or fields[1] != url.rsplit("/", 1)[-1] or not DIGEST.fullmatch(fields[0]):
        message = f"{url}.sha256 does not give this archive's SHA-256: {text[:200]!r}"
        raise FetchError(message)
    return fields[0]


def get(url: str, headers: dict[str, str] | None = None) -> bytes:
    """The body at URL, a listing or a digest, within its time and size."""
    request = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as reply:
        body = reply.read(LISTING_BYTES + 1)
    if len(body) > LISTING_BYTES:
        message = f"{url}: more than {LISTING_BYTES} bytes"
        raise FetchError(message)
    return body


def find_oss() -> tuple[str, str, str]:
    """The latest dbt-oss, from GitHub's releases, with GH_TOKEN when it is set."""
    headers = {"Accept": "application/vnd.github+json"}
    if token := os.environ.get("GH_TOKEN"):
        headers["Authorization"] = f"Bearer {token}"
    return latest_oss(json.loads(get(RELEASES, headers)))


def find_proprietary() -> tuple[str, str, str]:
    """The stable proprietary dbt, from dbt Labs' versions.json and its `.sha256`."""
    version, url = latest_proprietary(json.loads(get(VERSIONS)))
    return version, url, sidecar_digest(get(f"{url}.sha256").decode(errors="replace"), url)


LATEST = {"oss": find_oss, "proprietary": find_proprietary}


def fetch(url: str, sha256: str, directory: Path) -> Path:
    """Download the archive at `url`, check it against `sha256`, and write its `dbt` in `directory`."""
    directory.mkdir(parents=True, exist_ok=True)
    # So that a failure leaves no binary, not even an older one.
    (directory / "dbt").unlink(missing_ok=True)
    with tempfile.TemporaryDirectory(dir=directory) as scratch:
        archive, hashed, size = Path(scratch) / "dbt.tar.gz", hashlib.sha256(), 0
        with urllib.request.urlopen(url, timeout=TIMEOUT_SECONDS) as reply, archive.open("wb") as out:
            while chunk := reply.read(CHUNK_BYTES):
                size += len(chunk)
                if size > LIMIT_BYTES:
                    message = f"{url}: more than {LIMIT_BYTES} bytes"
                    raise FetchError(message)
                hashed.update(chunk)
                out.write(chunk)
        if hashed.hexdigest() != sha256:
            message = f"{url}: SHA-256 {hashed.hexdigest()}, not the pinned {sha256}"
            raise FetchError(message)
        with tarfile.open(archive) as tar:
            members = [m for m in tar.getmembers() if m.isfile() and Path(m.name).name == "dbt"]
            if len(members) != 1:
                message = f"{url}: {len(members)} files named dbt, not one"
                raise FetchError(message)
            binary = Path(scratch) / "dbt"
            with tar.extractfile(members[0]) as source, binary.open("wb") as out:
                shutil.copyfileobj(source, out)
        binary.chmod(0o755)
        return Path(shutil.move(binary, directory / "dbt"))


def main(arguments: list[str]) -> int:
    """Fetch the build that ARGUMENTS name: 0 with its binary, 2 otherwise."""
    latest = arguments[:1] == ["--latest"]
    build, *rest = (arguments[1:] if latest else arguments) or [""]
    if build not in BUILDS or len(rest) != 1:
        print(f"usage: scripts/fetch-dbt [--latest] {'|'.join(BUILDS)} DIR", file=sys.stderr)
        return 2
    try:
        if latest:
            version, url, sha256 = LATEST[build]()
            print(f"{build} {version} {url} {sha256}", flush=True)
        else:
            url, sha256 = BUILDS[build]
        binary = fetch(url, sha256, Path(rest[0]))
    except (FetchError, OSError, ValueError, http.client.HTTPException, tarfile.TarError) as error:
        print(f"fetch-dbt: {error}", file=sys.stderr)
        return 2
    print(binary)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

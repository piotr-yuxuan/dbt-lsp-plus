#!/usr/bin/env python3
# SPDX-License-Identifier: EUPL-1.2 OR GPL-3.0-or-later
"""Check the size of src/ against two ceilings, the ratchet of the reduction chain.

Usage: scripts/check-size LINES TYPES

Run from the repository's root.  Production lines are the lines of each src/**/*.rs,
before its test module (a line `#[cfg(test)]`, then `mod NAME {` at the start of the
next), that are neither blank nor comments (`//`, `///`, `//!`).  Types are the
`struct`, `enum`, `union`, `trait`, `unsafe trait` and `type` items among them.  The
rule is the reduction audit's, blind spots included: a `#[cfg(test)]` item outside the
test module counts, and a type that a macro makes does not.  A file with code after
its test module, whose `}` rustfmt writes at the start of a line, fails: that code
would escape both counts.  It prints both figures and their ceilings.  Status 0 when
neither figure is above its ceiling, 1 when one is, or, with the file named on the
standard error and nothing on the standard output, when a file has code after its
test module; 2 when LINES or TYPES is not a whole number or there is no src/, with
nothing on the standard output.
"""

import re
import sys
from pathlib import Path

TEST_MODULE = re.compile(r"mod \w+\s*\{")
TYPE = re.compile(r"\s*(pub(\([^)]*\))?\s+)?(unsafe\s+)?(struct|enum|union|trait|type)\s+\w+")


def measure(text: str) -> tuple[int, int]:
    lines = text.splitlines()
    code = [bool(line.strip()) and not line.strip().startswith("//") for line in lines]
    starts = (at for at in range(len(lines) - 1) if lines[at].strip() == "#[cfg(test)]")
    end = next((at for at in starts if TEST_MODULE.match(lines[at + 1])), len(lines))
    closing = next((at for at in range(end, len(lines)) if lines[at] == "}"), len(lines))
    if any(code[closing + 1 :]):
        raise ValueError("code after its test module")
    kept = [lines[at] for at in range(end) if code[at]]
    return len(kept), sum(1 for line in kept if TYPE.match(line))


def main(arguments: list[str]) -> int:
    src = Path("src")
    whole = len(arguments) == 2 and all(re.fullmatch("[0-9]+", word) for word in arguments)
    if not whole or not src.is_dir():
        print("usage: scripts/check-size LINES TYPES, from the repository's root", file=sys.stderr)
        return 2
    lines, types = int(arguments[0]), int(arguments[1])
    measured = []
    for path in sorted(src.rglob("*.rs")):
        try:
            measured.append(measure(path.read_text()))
        except ValueError as error:
            print(f"check-size: {path}: {error}", file=sys.stderr)
            return 1
    found_lines, found_types = sum(m[0] for m in measured), sum(m[1] for m in measured)
    print(f"check-size: {found_lines} production lines, at most {lines};", end=" ")
    print(f"{found_types} types, at most {types}")
    return 1 if found_lines > lines or found_types > types else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
